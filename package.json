{
  "name": "hrv-card",
  "version": "1.0.0",
  "description": "Home Assistant Lovelace card for a heat-recovery ventilation unit with a heat pump",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
